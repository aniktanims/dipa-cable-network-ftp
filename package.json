{
  "name": "movie-fetcher",
  "version": "2.1.0",
  "description": "Browse, stream and download movies and series from DHAKA FLIX",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "build": "electron-builder --win portable",
    "build:ios": "node build-ios.js"
  },
  "build": {
    "appId": "com.dhakaflix.moviefetcher",
    "productName": "DHAKA FLIX Movie Fetcher",
    "asar": true,
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "portable"
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MovieFetcher-Portable-${version}.exe"
    },
    "files": [
      "electron.js",
      "server.js",
      "core.js",
      "player.js",
      "mkv.js",
      "player-ui.js",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "copyright": "Copyright © 2026 Mostofa Tanim Anik",
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "author": {
    "name": "Mostofa Tanim Anik"
  }
}
