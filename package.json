{
  "name": "movie-fetcher",
  "version": "2.1.0",
  "description": "DHAKA FLIX Movie Fetcher",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "build": "electron-builder --win portable dir",
    "build:ios": "node build-ios.js"
  },
  "build": {
    "appId": "com.dhakaflix.moviefetcher",
    "productName": "DHAKA FLIX Movie Fetcher",
    "asar": true,
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "portable"
        }
      ]
    },
    "portable": {
      "artifactName": "MovieFetcher-Portable.exe"
    },
    "files": [
      "electron.js",
      "server.js",
      "core.js",
      "player.js",
      "mkv.js",
      "player-ui.js",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
